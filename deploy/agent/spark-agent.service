[Unit]
Description=Spark Cloud node agent
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/spark-agent run
Restart=always
RestartSec=3
OOMScoreAdjust=-900
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
