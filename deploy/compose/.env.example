# 复制为 .env 后填写。端口对应：22→SPARK_SSH_ADDR、443→SPARK_HTTP_ADDR、80→SPARK_HTTP_REDIRECT_ADDR、9443→SPARK_AGENT_ADDR、127.0.0.1:8081→SPARK_ADMIN_ADDR
# 口令只用字母数字（它会拼进 SPARK_DATABASE_URL，不做 URL 转义）
POSTGRES_PASSWORD=change-me
PLATFORM_VERSION=latest
SPARK_ENV=prod
SPARK_DOMAIN=spark.example
SPARK_INGRESS_DOMAIN=sparkapp.example        # 推荐与 SPARK_DOMAIN 不同的注册域；相同也可
SPARK_PUBLIC_BASE_URL=https://spark.example
SPARK_HTTP_ADDR=:8443
SPARK_HTTP_REDIRECT_ADDR=:8080
# 后台在容器内监听所有网卡（否则容器外到不了），compose 只把它发布到宿主机 127.0.0.1:8081；启动日志的「后台 API 监听在所有网卡上」提示在此可忽略
SPARK_ADMIN_ADDR=:8081
SPARK_SSH_ADDR=:2222
SPARK_SSH_PUBLIC_PORT=22
SPARK_AGENT_ADDR=:9443
SPARK_AGENT_HOSTS=agent.spark.example       # Agent 连接的网关域名或 IP（证书 SAN）
AGENT_BIND_IP=10.0.0.10                     # 控制面宿主机的机房内网地址，9443 只发布在这个地址上
SPARK_TLS_CERT_FILE=/certs/fullchain.pem
SPARK_TLS_KEY_FILE=/certs/privkey.pem
# platform 自己终止 TLS，前面没有代理：保持 false。只有在前置反向代理之后才设 true（见 README「部署注意」）
SPARK_TRUST_PROXY=false
# openssl rand -base64 32（空值后面不能写行内注释：compose 会把注释当成值）
SPARK_SECRET_KEY=
SPARK_UPSTREAM_SSH_KEY_FILE=/secrets/upstream.key
SPARK_UPSTREAM_SSH_KEY_HOST_PATH=/opt/spark/upstream.key   # 宿主机路径，属主 65532、权限 0600
SPARK_UPLOAD_DIR=/data/uploads
SPARK_SMS_DRIVER=aliyun
SPARK_KYC_DRIVER=aliyun
SPARK_PAY_DRIVER=real
SPARK_PDU_DRIVER=snmp
# 其余阿里云 / 微信 / 支付宝变量见 README 配置表（容器内的文件路径需另加卷挂载，文件属主 65532）
ALI_KEY=
ALI_SECRET=
