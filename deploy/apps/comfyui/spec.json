{
  "ports": [{"port": 8188, "label": "ComfyUI 界面", "health_path": "/system_stats"}],
  "timeout_minutes": 90,
  "min_data_free_gib": 50,
  "supports_workflows": true,
  "env": [
    {"name": "MODEL_ID", "label": "模型", "type": "enum", "required": true,
     "options": ["none", "AI-ModelScope/stable-diffusion-xl-base-1.0", "AI-ModelScope/FLUX.1-schnell", "Qwen/Qwen-Image"], "default": "none",
     "help": "预置模型，下载 ComfyUI 可直接加载的单文件权重：SDXL 约 7GB、FLUX.1-schnell 约 34GB（hf-mirror 为 17GB fp8 版）、Qwen-Image（fp8）约 30GB。选 none 只装工作流清单里的模型"},
    {"name": "MODEL_SOURCE", "label": "下载源", "type": "enum", "options": ["modelscope", "hf-mirror"], "default": "modelscope"}
  ]
}
